# === Gemini Image Generation ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# === Avatar & Output Paths ===
REFERENCE_FACE_PATH=avatar/reference_face.jpg
OUTPUT_DIR=generated_images

# === Google Drive ===
# Folder ID from Google Drive URL (created automatically if using Antigravity setup)
GDRIVE_FOLDER_ID=your_gdrive_folder_id_here
# For standalone Python runs: path to OAuth client secrets JSON (from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Set true to make uploaded Drive images readable via link (needed if Instagram fetches directly from Drive)
DRIVE_PUBLIC_FOR_IG=true
# Optional: set true when running inside Antigravity agent to use `gdrive` CLI directly
USE_ANTIGRAVITY_GDRIVE=false

# === Instagram Graph API (Business / Creator Account) ===
INSTAGRAM_ACCOUNT_ID=your_ig_business_account_id_here
INSTAGRAM_ACCESS_TOKEN=your_long_lived_meta_access_token_here
GRAPH_API_VERSION=v21.0

# Optional: ImgBB API key if you prefer hosting temporary public URLs on ImgBB instead of public Drive links
IMGBB_API_KEY=
